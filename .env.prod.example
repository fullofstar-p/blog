# ============================================================================
# 技术分享博客 · 生产环境变量模板（服务器上的 .env）
#
#   cp .env.prod.example .env
#   chmod 600 .env
#   vim .env        # 把「必填」项填上，留空的必填项会让 compose 直接报错退出
#
# 这个文件只放在服务器 /opt/blog/.env，不进 Git（.gitignore 已忽略 .env.prod / .env）。
# 完整说明见 docs/DEPLOY.md。
# ============================================================================

# ---------------- 镜像（GitHub Actions 构建后推到阿里云 ACR） ----------------
# IMAGE_REGISTRY：服务器「拉取」用的 ACR 域名。
#   ECS 与 ACR 在同一地域时用 VPC 域名：免公网流量、快、不经过公网入口（推荐）。
#   域名在 ACR 控制台实例详情页复制，别手写：
#     个人版（2024-09 后新建）   crpi-xxxx-vpc.cn-hangzhou.personal.cr.aliyuncs.com
#     个人版（旧实例）           registry-vpc.cn-hangzhou.aliyuncs.com
#     企业版                     <实例名>-registry-vpc.cn-hangzhou.cr.aliyuncs.com
#   GitHub Actions 推送用的是去掉 -vpc 的公网域名，两者指向同一批镜像，路径一致。
IMAGE_REGISTRY=crpi-xxxx-vpc.cn-hangzhou.personal.cr.aliyuncs.com
# ACR 命名空间（控制台创建，必须和 Actions 仓库变量 ACR_NAMESPACE 一致）
IMAGE_NAMESPACE=blog
# latest = 默认分支 master 的最新构建；回滚时可改成具体 sha-xxxxxxx 或 dev / v1.0.0
IMAGE_TAG=latest
# 基础镜像（mysql / redis / rustfs）也从同一个 ACR 命名空间拉取，无需单独配置；
# 升级基础镜像：改 .github/workflows/sync-infra.yml 里的 tag 后手动 Run workflow。
TZ=Asia/Shanghai

# ---------------- 对外访问地址 ----------------
# 必填：浏览器访问博客的地址（不要以 / 结尾），用于拼接图片 URL：{PUBLIC_BASE_URL}/files/blog/xxx.png
PUBLIC_BASE_URL=https://blog.example.com
# 宿主机 Nginx 反代的本地端口（只监听 127.0.0.1，不用在安全组放行）
FRONTEND_HOST_PORT=8081
# 对象存储 S3 API 的本地端口（只监听 127.0.0.1，由 Nginx /files/ 反代）
OBJECTSTORE_HOST_PORT=9000

# ---------------- MySQL ----------------
# 必填：首次启动即固化，改密码不会自动改已有数据卷里的 root 密码
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=blog

# ---------------- 对象存储凭据（同时供后端 S3Client 使用） ----------------
# 必填：生产不要再用 minioadmin
# MINIO_ROOT_USER 就是 S3 的 access key，会被拼进 SigV4 的 Credential 段：
#   只允许 A-Z a-z 0-9（建议 16-20 位大写+数字），不能含 / + = 空格 —— 含 / 会让上传 403
#   生成：openssl rand -hex 10 | tr 'a-f' 'A-F'
# MINIO_ROOT_PASSWORD 是 secret key，不做格式限制，建议 hex：
#   生成：openssl rand -hex 32
# 注意：不要用 `openssl rand -base64`，它输出的 / 正是踩坑来源。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=blog

# ---------------- JWT ----------------
# 必填：HS256 签名密钥，≥ 64 字符随机串。生成：openssl rand -base64 64 | tr -d '\n'
# 注意：换掉 JWT_SECRET 会让所有已登录用户的 token 失效（需重新登录）
JWT_SECRET=
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# ---------------- 初始管理员（仅当库里没有任何 ADMIN 用户时创建） ----------------
# 必填：首次启动创建；之后改这里不会覆盖已有账号密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------- 站点名（分享卡片底部展示） ----------------
BLOG_SITE_NAME=技术分享博客
