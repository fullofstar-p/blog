# ============================================================================
# 技术分享博客 · 生产环境变量模板（服务器上的 .env）
#
#   cp .env.prod.example .env
#   chmod 600 .env
#   vim .env        # 把「必填」项填上，留空的必填项会让 compose 直接报错退出
#
# 这个文件只放在服务器 /opt/blog/.env，不进 Git（.gitignore 已忽略 .env.prod / .env）。
# 完整说明见 docs/DEPLOY.md。
# ============================================================================

# ---------------- 镜像（GitHub Actions 推到 GHCR 的地址） ----------------
# {owner}/{repo} 用你自己的小写仓库全名；和 release.yml 里的命名保持一致
IMAGE_NAMESPACE=ghcr.io/fullofstar-p/blog
# latest = 默认分支 master 的最新构建；回滚时可改成具体 sha-xxxxxxx 或 dev / v1.0.0
IMAGE_TAG=latest
# 对象存储镜像：默认 RustFS（MinIO 社区镜像已下架）；也可填自备镜像仓库的 MinIO
OBJECTSTORE_IMAGE=rustfs/rustfs:latest
TZ=Asia/Shanghai

# ---------------- 对外访问地址 ----------------
# 必填：浏览器访问博客的地址（不要以 / 结尾），用于拼接图片 URL：{PUBLIC_BASE_URL}/files/blog/xxx.png
PUBLIC_BASE_URL=https://blog.example.com
# 宿主机 Nginx 反代的本地端口（只监听 127.0.0.1，不用在安全组放行）
FRONTEND_HOST_PORT=8081
# 对象存储 S3 API 的本地端口（只监听 127.0.0.1，由 Nginx /files/ 反代）
OBJECTSTORE_HOST_PORT=9000

# ---------------- MySQL ----------------
# 必填：首次启动即固化，改密码不会自动改已有数据卷里的 root 密码
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=blog

# ---------------- 对象存储凭据（同时供后端 S3Client 使用） ----------------
# 必填：至少 8 位，建议随机；生产不要再用 minioadmin
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=blog

# ---------------- JWT ----------------
# 必填：HS256 签名密钥，≥ 64 字符随机串。生成：openssl rand -base64 64 | tr -d '\n'
# 注意：换掉 JWT_SECRET 会让所有已登录用户的 token 失效（需重新登录）
JWT_SECRET=
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# ---------------- 初始管理员（仅当库里没有任何 ADMIN 用户时创建） ----------------
# 必填：首次启动创建；之后改这里不会覆盖已有账号密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------- 站点名（分享卡片底部展示） ----------------
BLOG_SITE_NAME=技术分享博客
