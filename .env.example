# ============================================================================
# 技术分享博客 · 本地开发 Docker Compose 环境变量示例
# 复制为 .env 后修改：cp .env.example .env
# 生产环境不要用这个文件，用 .env.prod.example（见 docs/DEPLOY.md）。
# ============================================================================

# ---------------- MySQL ----------------
# 仅本地开发；生产用随机强密码
MYSQL_ROOT_PASSWORD=change_me_mysql_root
# 注意：sql/init.sql 中库名固定为 blog，若要改这里，请同步修改初始化 SQL
MYSQL_DATABASE=blog
MYSQL_PORT=3306

# ---------------- Redis ----------------
REDIS_PORT=6379

# ---------------- 对象存储（S3 API） ----------------
# 变量名沿用 MINIO_*，因为后端按这些名字读配置；实现可以是 MinIO，也可以是任何 S3 兼容服务。
# 控制台/API 凭据（同时作为后端访问对象存储的 access-key / secret-key）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_pwd
# 后端启动时自动创建该 bucket，并设置「公共读」策略
MINIO_BUCKET=blog
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# 浏览器可访问的对象存储地址（宿主机视角），用于拼接图片 URL
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# 仅本地基础设施 compose（docker-compose.infra.yml）使用：对象存储镜像。
# MinIO 社区镜像 2026-09 已从 Docker Hub 下架，默认改用 S3 兼容的 RustFS；
# 若自备 MinIO 镜像仓库，把它改成你的镜像地址即可。
OBJECTSTORE_IMAGE=rustfs/rustfs:latest
# 完整栈（docker-compose.yml）使用：MinIO 镜像地址，同样需要自备可拉取的镜像。
MINIO_IMAGE=minio/minio:latest

# ---------------- 后端 / JWT ----------------
# 仅本地开发使用；生产务必用随机长字符串（>= 64 字符）：
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change_me_generate_with_openssl_rand_base64_64
# access token 有效期（秒），默认 2 小时
JWT_ACCESS_EXPIRE=7200
# refresh token 有效期（秒），默认 7 天
JWT_REFRESH_EXPIRE=604800
BACKEND_PORT=8080

# ---------------- 初始管理员（首次启动由后端创建） ----------------
# 生产环境务必修改；仅在数据库里没有任何 ADMIN 用户时生效
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ---------------- 前端 ----------------
FRONTEND_PORT=80
