{
  "name": "blog-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "技术分享博客 · Vue3 + Tailwind Sketch Style 前端",
  "scripts": {
    "predev": "node scripts/copy-vditor.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-vditor.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.vue --max-warnings=0",
    "lint:fix": "eslint src --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{vue,js,css}\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "highlight.js": "^11.9.0",
    "md-editor-v3": "^4.0.0",
