# ============================================================================
# 技术分享博客 · 宿主机 Nginx 反向代理模板（Ubuntu 24.04）
#
# 用法（在服务器仓库根目录执行，把 blog.example.com 换成你的域名）：
#   sudo sed "s/__DOMAIN__/blog.example.com/g" deploy/nginx/blog.conf.template \
#     | sudo tee /etc/nginx/sites-available/blog.conf >/dev/null
#   sudo ln -sf /etc/nginx/sites-available/blog.conf /etc/nginx/sites-enabled/blog.conf
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#
# HTTPS：证书由 certbot 自动申请并回写本文件（见 docs/DEPLOY.md 第 6 节）。
#
# 端口对应关系（改过 .env 里的端口的话，这里也要同步改）：
#   frontend 容器 nginx  →  127.0.0.1:8081
#   对象存储 S3 API      →  127.0.0.1:9000
# ============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # 与前端容器内 nginx 的 client_max_body_size 10m 保持一致（后端单文件上限 5MB）
    client_max_body_size 10m;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ------------------------------------------------------------------------
    # 对象存储图片直链：后端把 URL 拼成 {PUBLIC_BASE_URL}/files/{bucket}/{key}
    # S3 path-style，代理时去掉 /files/ 前缀：/files/blog/xx.png → /blog/xx.png
    # 只允许读，避免匿名 PUT/DELETE 打到对象存储。
    # ------------------------------------------------------------------------
    location ^~ /files/ {
        limit_except GET {
            deny all;
        }

        proxy_pass http://127.0.0.1:9000/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    # ------------------------------------------------------------------------
    # 站点入口：静态资源 + /api（前端容器内 nginx 再反代 backend:8080）
    # ------------------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        # 分享卡片 PNG、导出等接口较慢，留足超时
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
